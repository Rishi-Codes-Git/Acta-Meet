# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (Docker setup)
DATABASE_URL=postgresql://mom_user:password@localhost:5432/mom_db

# JWT
JWT_SECRET=acta-super-secret-jwt-key-2026-hackathon
JWT_EXPIRES_IN=7d

# Ollama (Local AI - FREE)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local Speech-to-Text (Whisper via transformers.js)
STT_MODEL=Xenova/whisper-small
STT_CHUNK_LENGTH_SECONDS=30
STT_STRIDE_LENGTH_SECONDS=5

# n8n automation (Jira + Trello)
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_TASK_CREATED_PATH=/task-created
N8N_TASK_UPDATED_PATH=/task-updated

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
